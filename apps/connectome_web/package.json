  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.61.1",
    "@types/plotly.js": "3.0.8",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/react-plotly.js": "2.6.4",
    "@vitejs/plugin-react": "4.7.0",
