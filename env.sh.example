# Toolchain and data locations. Copy to env.sh, edit, then `source env.sh`.
# env.sh is gitignored: these paths are specific to one machine.
#
# Everything here is checked by `python sc_doctor.py`.

# ---- data -------------------------------------------------------------------
# At most three roots. Each derived location can also be overridden on its own;
# see the list in sc_config.py.
export SC_PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SC_DATA_ROOT="${SC_PROJECT_ROOT}/data"
# export SC_DERIV_ROOT="/mnt/adni/derivatives"
# export SC_RAW_IMAGES_ROOT="/mnt/adni/Images"

# ---- imaging toolchain ------------------------------------------------------
# These are usually installed but not exported, which is what makes a run die
# in the middle with a message that looks like a data problem.

# MRtrix3. Use the MRtrix3Tissue build if you need ss3t_csd_beta1 for the
# single-shell three-tissue CSD; this cohort's ADNI DWI is single-shell.
export MRTRIX_BIN="${HOME}/mrtrix3/bin"
# export MRTRIX_BIN="${HOME}/MRtrix3Tissue/bin"

# FSL. FSLDIR is the FSL installation root: the folder that contains
# etc/fslconf/fsl.sh and data/standard/. With the official installer that is
# ~/fsl. Sourcing fsl.sh puts the FSL tools on PATH for you.
export FSLDIR="${HOME}/fsl"
[ -f "${FSLDIR}/etc/fslconf/fsl.sh" ] && . "${FSLDIR}/etc/fslconf/fsl.sh"
export FSLOUTPUTTYPE="${FSLOUTPUTTYPE:-NIFTI_GZ}"

# ANTs.
export ANTSPATH="${SC_PROJECT_ROOT}/.envs/ants-2.6.5/bin"

# ${FSLDIR}/bin is deliberately NOT added: it also holds FSL's own Python, which
# would shadow yours. fsl.sh above already added the FSL tools.
export PATH="${MRTRIX_BIN}:${ANTSPATH}:${PATH}"

# ---- python -----------------------------------------------------------------
# export PATH="${SC_PROJECT_ROOT}/.venv/bin:${PATH}"
