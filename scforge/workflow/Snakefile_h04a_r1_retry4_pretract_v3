def _sha256(path):
    return _source_sha256(path)


def _is_relative_to(path, parent):
    try:
        Path(path).resolve().relative_to(Path(parent).resolve())
        return True
    except ValueError:
        return False


def _validate_static_contract():
    contract = config["contract"]
    if (
        contract.get("status") != "implementation_candidate_pending_validation"
        or contract.get("imaging_execution_authorized") is not False
        or contract.get("current_human_gate") != "SL-H03-C1"
        or contract.get("authorization_scope") != "design_only_no_imaging"
        or contract.get("next_execution_gate") != "SL-H04A"
    ):
        raise ValueError(
            "current recipe must remain an SL-H03-C1 design-only implementation "
            "candidate pending a separate SL-H04A imaging decision"
        )
    if config["contract"].get("failure_policy") != "fail_closed":
        raise ValueError("connectome_v2 contract must remain fail_closed")
    if config["contract"].get("silent_fallbacks_allowed") is not False:
        raise ValueError("Silent fallbacks are forbidden")
    if config["contract"].get("select_route_by_connectome_density") is not False:
        raise ValueError("Density-based route selection is forbidden")
    if config["qc"]["matrix"].get("density_used_as_inclusion_gate") is not False:
        raise ValueError("Density cannot be an inclusion gate")
    if EXPECTED_MATRICES != (
        "count",
        "fd_sum",
        "count_invnodevol",
        "len_mean",
        "invlen_mean",
        "fa_mean",
        "md_mean",
        "rd_mean",
        "ad_mean",
    ):
        raise ValueError(f"Unexpected required matrix contract: {EXPECTED_MATRICES}")
    if config["connectome"]["assignment"].get("method") != "radial_search":
        raise ValueError("Only the frozen radial_search assignment is permitted")
    if int(config["connectome"]["assignment"].get("radius_mm")) != 4:
        raise ValueError("The primary recipe requires one uniform 4-mm radius")
    pairing = config["inputs"]["pairing"]
    if pairing.get("processing_rejection_by_abs_gap_allowed") is not False:
        raise ValueError("DTI/T1 gap must be an analysis stratum, not a processing rejection")
    if pairing.get("processing_rejection_by_diagnosis_allowed") is not False:
        raise ValueError("Diagnosis must not select or reject the processing route")
    if pairing.get("processing_rejection_by_t1_source_kind_allowed") is not False:
        raise ValueError("DICOM versus NIfTI T1 source kind must not reject processing")
    if config["inputs"]["source_normalization"].get("missing_phase_encoding_or_readout") != "per_unit_FAIL_no_default_no_imputation":
        raise ValueError("Missing PE/readout metadata must fail closed per unit")
    if int(config["inputs"]["approved_pair_manifest"].get("required_row_count", 0)) != 530:
        raise ValueError("SL-D01 processing denominator must remain exactly 530 rows")

    forbidden = (
        Path("/data/derivatives/connectomes"),
        Path("/data/derivatives/qc/sc_matrix_qc"),
        PROJECT_ROOT / "research_audit" / "snapshots",
    )
    if "scforge_v2" not in str(RUN_ROOT):
        raise ValueError(
            f"run_root must contain the safety token 'scforge_v2': {RUN_ROOT}"
        )
    if any(_is_relative_to(RUN_ROOT, path) or _is_relative_to(path, RUN_ROOT) for path in forbidden):
        raise ValueError(f"run_root overlaps a protected historical/production tree: {RUN_ROOT}")
    if RUN_ROOT in (PROJECT_ROOT, Path("/")):
        raise ValueError(f"Unsafe run_root: {RUN_ROOT}")
    for label, path in (
        ("resolved_run_config", RESOLVED_RUN_CONFIG),
        ("run_context", RUN_CONTEXT_PATH),
        ("attempt_context", ATTEMPT_CONTEXT_PATH),
    ):
        if path != NORMATIVE_CONFIG and not _is_relative_to(path, RUN_ROOT):
            raise ValueError(f"{label} must be inside run_root: {path}")
_validate_static_contract()
MANIFEST_ROWS = load_acquisition_manifest(
    MANIFEST_PATH,
    ACQUISITION_SCHEMA,
    run_root=RUN_ROOT,
    expected_rows=int(config["inputs"]["approved_pair_manifest"]["required_row_count"]),
)
EXECUTION_ROWS = validate_execution_subset(
    MANIFEST_ROWS,
    load_acquisition_manifest(
        EXECUTION_MANIFEST_PATH,
        ACQUISITION_SCHEMA,
        run_root=RUN_ROOT,
    ),
)
ROW_BY_UNIT = {row["unit"]: row for row in EXECUTION_ROWS}
EXECUTION_UNITS = tuple(sorted(ROW_BY_UNIT))
EXECUTION_BINDING = config.get("execution_binding")
if not isinstance(EXECUTION_BINDING, dict):
    raise ValueError("supported execution requires an immutable canary subset binding")
_expected_execution_records = {
    "parent_acquisition_manifest": MANIFEST_PATH,
    "execution_subset_manifest": EXECUTION_MANIFEST_PATH,
}
for _name, _path in _expected_execution_records.items():
    _record = EXECUTION_BINDING.get(_name, {})
    if (
        Path(str(_record.get("path", ""))).resolve() != _path
        or _record.get("sha256") != _sha256(_path)
        or _record.get("size_bytes") != _path.stat().st_size
    ):
        raise ValueError(f"canary execution binding differs at {_name}")
_decision_record = EXECUTION_BINDING.get("execution_subset_decision", {})
_decision_path = Path(str(_decision_record.get("path", ""))).resolve()
if (
    EXECUTION_BINDING.get("schema_version") != "2.0.0"
    or EXECUTION_BINDING.get("binding_type")
    != "connectome_execution_subset_binding"
    or EXECUTION_BINDING.get("execution_scope") != "canary"
    or EXECUTION_BINDING.get("recipe_id") != RECIPE_ID
    or EXECUTION_BINDING.get("approved_unit_count") != len(EXECUTION_UNITS)
    or EXECUTION_BINDING.get("units") != list(EXECUTION_UNITS)
    or EXECUTION_BINDING.get("diagnosis_labels_used") is not False
    or EXECUTION_BINDING.get("selection_locked") is not True
    or not _decision_path.is_file()
    or _decision_record.get("sha256") != _sha256(_decision_path)
    or _decision_record.get("size_bytes") != _decision_path.stat().st_size
):
    raise ValueError("canary execution binding semantics or decision evidence differ")

PRETRACT_EXTENSION_BINDING = validate_pretract_extension_binding(
    config.get("pretract_extension_binding"),
    expected_run_root=RUN_ROOT,
    execution_binding=EXECUTION_BINDING,
)

LAUNCHER_MODE = str(config.get("launcher_mode", ""))
TRACTOGRAPHY_CONTINUATION_BINDING = config.get(
    "tractography_continuation_binding"
)
if LAUNCHER_MODE == "phase-b":
    if not isinstance(TRACTOGRAPHY_CONTINUATION_BINDING, dict):
        raise ValueError("phase B requires an immutable tractography continuation binding")
    _approved_units = TRACTOGRAPHY_CONTINUATION_BINDING.get("approved_units")
    if (
        TRACTOGRAPHY_CONTINUATION_BINDING.get("schema_version") != "2.0.0"
        or TRACTOGRAPHY_CONTINUATION_BINDING.get("binding_type")
        != "tractography_continuation_binding"
        or TRACTOGRAPHY_CONTINUATION_BINDING.get("execution_scope") != "canary"
        or TRACTOGRAPHY_CONTINUATION_BINDING.get("recipe_id") != RECIPE_ID
        or TRACTOGRAPHY_CONTINUATION_BINDING.get("execution_subset_manifest")
        != EXECUTION_BINDING.get("execution_subset_manifest")
        or TRACTOGRAPHY_CONTINUATION_BINDING.get("diagnosis_labels_used") is not False
        or not isinstance(_approved_units, list)
        or not _approved_units
        or any(not isinstance(unit, str) or not unit for unit in _approved_units)
        or _approved_units != sorted(set(_approved_units))
        or not set(_approved_units).issubset(EXECUTION_UNITS)
        or TRACTOGRAPHY_CONTINUATION_BINDING.get("approved_unit_count")
        != len(_approved_units)
    ):
        raise ValueError("phase-B approved units differ from the canary continuation binding")
    PHASE_B_UNITS = tuple(_approved_units)
else:
    if TRACTOGRAPHY_CONTINUATION_BINDING is not None:
        raise ValueError("pre-tractography modes cannot carry a continuation binding")
    PHASE_B_UNITS = EXECUTION_UNITS

# ``EXECUTION_UNITS`` remains the expected canary denominator.  ``UNITS`` is
# deliberately the scheduled DAG set, which is the human-approved subset in
# phase B so preflight failures are never sent into tractography.
UNITS = PHASE_B_UNITS if LAUNCHER_MODE == "phase-b" else EXECUTION_UNITS


def row_value(wildcards, key):
    return ROW_BY_UNIT[str(wildcards.unit)][key]


def source_input(key):
    return lambda wildcards: row_value(wildcards, key)


def raw_modality_input(modality):
    return lambda wildcards: [
        ancient(str(path))
        for path in raw_source_paths(ROW_BY_UNIT[str(wildcards.unit)], modality)
    ]


def subject_path(unit, *parts):
    return str(RUN_ROOT / "subjects" / str(unit) / Path(*parts))


def run_path(*parts):
    return str(RUN_ROOT / Path(*parts))


def subject_log(unit, name):
    return subject_path(unit, "logs", name)


def matrix_path(unit, metric):
    return subject_path(unit, "07_connectome", "matrices", f"{metric}.csv")


def all_matrix_paths(unit):
    return [matrix_path(unit, metric) for metric in EXPECTED_MATRICES]


