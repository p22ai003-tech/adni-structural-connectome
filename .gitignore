# ==============================================================================
# ADNI structural connectome — repository ignore rules
#
# This project processes ADNI data under a Data Use Agreement. Participant
# imaging, participant-level derivatives and clinical tables MUST NOT enter git
# history: once committed they are effectively permanent, even if later deleted.
#
# Rules below are ordered: (1) restricted data, (2) secrets, (3) heavy or
# generated artifacts, (4) caches and editor noise.
# ==============================================================================

# ------------------------------------------------------------------ 1. ADNI --
# The data volume itself (a symlink to /data).
/data

# Clinical tables: Subject ID paired with Sex, Age, APOE genotype, exact study
# dates, MMSE / CDR / FAQ / GDSCALE / NPI-Q. A re-identifiable limited dataset.
/cohort/

# Audit outputs: ~1 GB, subject-keyed. Includes cohort_audit_manifest.csv
# (identifier + age to 1 dp + exact dates + APOE) and two SQLite checkpoints
# holding 451,115 absolute paths to individual ADNI DICOMs.
/research_audit/outputs/
/research_audit/snapshots/

# Provenance-only tree; by its own index nothing here is needed by the live
# pipeline. Held raw ADNI DICOM archives and notebooks with external-drive dumps.
/archive/

# Imaging data, anywhere in the tree.
*.nii
*.nii.gz
*.mif
*.mih
*.tck
*.tsf
*.mgz
*.dcm
*.trk
tmp_*_S_*             # subject-named scratch files that reappear at the repo root
*_gmwmi.nii.gz
/reports/aal3_node_qc/gmwmi_cache/

# Connectome matrices and other participant-level derivatives, if ever copied in.
SC_AAL*_*.csv
SC_Schaefer*_*.csv
SC_HCPMMP1_*.csv

# Acquisition manifests. Every row names an ADNI participant and the absolute
# path to their imaging; these are generated by sc_discover.py / 
# sc_probe_acquisition.py on the machine that holds the data, never committed.
configs/acquisition_manifest*.csv
*acquisition_manifest*.csv
*_manifest_v2*.csv

# --------------------------------------------------------------- 2. secrets --
*credential*
*secret*
*.pem
*.key
*.p12
.env
.env.*
.netrc
.aws/
# AWS account / SSO identity captures
**/aws_aml_*.json

# --------------------------------------------- 3. heavy or generated output --
# Archives: the tree previously carried a 13.6 GiB zip of raw DICOMs.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Databases and run-state checkpoints
*.sqlite3
*.sqlite
*.db

# Virtual environments, vendored toolchains and pinned binaries
.venv*/
venv/
/.envs/
/.tools/
*.so
*.o
*.a

# Node
node_modules/
dist/
build/
*.tsbuildinfo

# Python build artefacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Logs and run state
*.log
logs/
/log/
.snakemake/
.snakemake*/
*.failed/
.*_work/
*.partial

# Editor / OS / backup noise
*.bak
*.bak[0-9]*
*.bak_*
*~
*.swp
*.orig
*.rej
.DS_Store
__MACOSX/
Thumbs.db

# --------------------------------------------------------------- 4. caches --
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
# Browser-test output, wherever it lands. A failed Playwright run writes
# screenshots, page snapshots and trace archives, and those can show
# participant-level pages and identifiers.
test-results/
playwright-report/
blob-report/


# --- generated analysis artifacts (subject-level rows; regenerated by the pipeline) ---
# These are RESULTS, not code. Several are participant-level: ml_targets.csv pairs
# subject IDs with MMSE/CDR/age/sex, the *_subject.csv tables and every *_cv_predictions
# / beeswarm file carry one row per participant. A code repository tracks none of them.
/hcp_analysis/*.csv
/hcp_analysis/*.json
/hcp_analysis/*.npz
/hcp_analysis/improve/*.npz
/hcp_analysis/figs/
/outputs/
/reports/

# Vendored third-party executables — install these, do not track them.
/tools/dcm2niix/

# ------------------------------------------------------------------ notes --
# Deliberately TRACKED despite looking generated:
#   apps/connectome_web/package-lock.json   npm ci in the runbook depends on it
#   atlas/AAL/*.csv                          atlas-space LUTs, no subject data
#   atlas/AAL/AAL3v1_1mm*.nii.gz             see negation below
#   configs/*.yaml                           the version + recipe contract
#
# The atlas volumes are atlas-space templates, not participant data, so they are
# re-included after the blanket *.nii.gz rule above.
!atlas/AAL/AAL3v1_1mm.nii.gz
!atlas/AAL/AAL3v1_1mm_166.nii.gz
!atlas/Schaefer2018/*.nii.gz

# Local subject-level exclusion lists. These name ADNI participants and are
# restricted under the Data Use Agreement; they stay on the machine.
configs/exclusions.local.yaml
*.local.yaml

# Machine-specific toolchain paths; env.sh.example is the tracked template.
/env.sh

# dwifslpreproc scratch directories: created in the working directory by a
# running job and deleted when it finishes. Never repository content.
dwifslpreproc-tmp-*/

# This machine's tool locations, written by `run_imaging.py lock-env`.
configs/environment.local.yaml
